// remarkable.typst — pandoc Typst template for the reMarkable Paper Pure.
//
//   pandoc -d remarkable notes.md -o notes.pdf
//
// Page is the device's native 4:3 (157×209mm) so the PDF fills the screen with
// no letterboxing. Monochrome-first: hierarchy comes from weight / rules / fill,
// never color. Mirrors ~/.claude/skills/remarkable-pdf/lib/remarkable.typ.

// ── grayscale ramp — body stays near-black; mid-grays dither and read muddy ──
#let ink    = luma(12)
#let strong-ink = luma(8)
#let subtle = luma(115)
#let faint  = luma(155)
#let hair   = luma(198)

#let horizontalrule = align(center, line(length: 40%, stroke: 0.6pt + hair))

// ── helpers usable from markdown via a ```{=typst} block ──

// An empty tick-box for "handled / done".
#let checkbox = box(width: 10pt, height: 10pt, stroke: 1pt + luma(30), radius: 1.5pt)

// A small tag chip. filled: true → solid black (sparingly, for urgent).
#let chip(label, filled: false) = box(
  inset: (x: 4pt, y: 1.6pt), radius: 2pt,
  fill: if filled { luma(15) } else { white },
  stroke: 0.7pt + luma(if filled { 15 } else { 90 }),
  text(size: 6.5pt, weight: "bold", tracking: 0.6pt,
       fill: if filled { white } else { luma(45) }, upper(label)),
)

// A ruled writing area for the Marker. Non-breakable so the caption never gets
// stranded at the foot of a page with its rules on the next one.
#let notes(lines: 4, gap: 8.5mm, label: "NOTES") = block(breakable: false, {
  v(4pt)
  if label != none {
    text(size: 6.5pt, weight: "bold", tracking: 1.2pt, fill: faint)[#label]
    v(1.5pt)
  }
  box(width: 100%, height: gap * lines, {
    for i in range(0, lines) {
      place(top + left, dy: gap * (i + 1), line(length: 100%, stroke: 0.4pt + hair))
    }
  })
})

#let callout(body) = block(fill: luma(244), radius: 3pt, inset: 7pt, width: 100%,
  text(size: 8.5pt, fill: luma(60), body))

// ── pandoc plumbing ──

#show terms: it => {
  it.children
    .map(child => [
      #strong[#child.term]
      #block(inset: (left: 1.5em, top: -0.4em))[#child.description]
      ])
    .join()
}

#show figure.where(kind: table): set figure.caption(position: $if(table-caption-position)$$table-caption-position$$else$top$endif$)
#show figure.where(kind: image): set figure.caption(position: $if(figure-caption-position)$$figure-caption-position$$else$bottom$endif$)

#let conf(
  title: none,
  subtitle: none,
  authors: (),
  keywords: (),
  date: none,
  abstract: none,
  cols: 1,
  margin: (top: 12mm, bottom: 11mm, left: 13mm, right: 12mm),
  paper: none,
  lang: "en",
  region: "US",
  font: ("Inter",),
  fontsize: 10.5pt,
  sectionnumbering: none,
  pagenumbering: "1",
  footer-note: "",
  doc,
) = {
  set document(title: title, author: (), keywords: keywords)

  set page(
    width: 157mm, height: 209mm,      // device-native 4:3
    margin: margin,
    columns: cols,
    footer: context {
      set text(size: 7pt, fill: faint)
      grid(columns: (1fr, auto), align: (left, right),
        footer-note,
        [#counter(page).display() / #counter(page).final().first()])
    },
  )

  set text(lang: lang, region: region, font: font, size: fontsize, fill: ink)
  set par(leading: 0.62em, justify: false, spacing: 0.85em)
  set heading(numbering: sectionnumbering)

  show heading.where(level: 1): it => { v(5pt); block(text(size: 15pt, weight: "bold", fill: strong-ink, it.body)); v(2pt) }
  show heading.where(level: 2): it => { v(4pt); block(text(size: 11.5pt, weight: "bold", fill: strong-ink, it.body)); v(1pt) }
  show heading.where(level: 3): it => { v(3pt); block(text(size: 9pt, weight: "bold", tracking: 1pt, fill: subtle, upper(it.body))) }
  show heading.where(level: 4): it => { block(text(size: 10pt, weight: "bold", style: "italic", fill: subtle, it.body)) }

  // Links are underlined, never colored — color is invisible on e-ink.
  show link: it => underline(offset: 1.5pt, stroke: 0.4pt + subtle, it)

  // Inline code + fenced blocks.
  show raw.where(block: false): it => box(
    fill: luma(240), inset: (x: 2.5pt), outset: (y: 2.5pt), radius: 2pt, it)
  show raw.where(block: true): it => block(
    fill: luma(245), inset: 7pt, radius: 3pt, width: 100%, breakable: true, it)
  set raw(theme: none)
  show raw: set text(font: "FiraCode Nerd Font", size: 8.5pt)

  show quote.where(block: true): it => block(
    inset: (left: 9pt), stroke: (left: 1.5pt + hair),
    text(fill: luma(70), style: "italic", it.body))

  // Tables: header rule + hairline row separators, no boxes.
  set table(
    inset: (x: 5pt, y: 4pt),
    stroke: (x, y) => (bottom: if y == 0 { 0.8pt + strong-ink } else { 0.3pt + hair }),
  )
  show table.cell.where(y: 0): set text(weight: "bold", size: 9pt)
  show table: set text(size: 9pt)
  // Pandoc wraps every table in `align(center)[…]`; on a narrow page a table
  // floating mid-column reads as a stray block, so pull it back to the margin.

  // Task lists: pandoc emits ☐/☒, which Inter renders as cramped little
  // glyphs. Swap in a real box big enough to tick with the Marker.
  show "☐": box(width: 9.5pt, height: 9.5pt, stroke: 0.9pt + luma(40), radius: 1.5pt)
  show "☒": box(width: 9.5pt, height: 9.5pt, stroke: 0.9pt + luma(40), radius: 1.5pt,
                align(center + horizon, text(size: 8pt, weight: "bold", fill: luma(40))[✓]))

  set list(indent: 4pt, spacing: 0.7em)
  set enum(indent: 4pt, spacing: 0.7em)

  set image(width: 100%, fit: "contain")

  if title != none {
    text(size: 19pt, weight: "bold", fill: strong-ink, title)
    if subtitle != none { v(1pt); text(size: 10pt, fill: subtle, subtitle) }
    if date != none { v(1pt); text(size: 8.5pt, fill: faint, date) }
    v(6pt)
  }

  if abstract != none {
    callout(abstract)
    v(4pt)
  }

  doc
}

$if(smart)$
$else$
#set smartquote(enabled: false)

$endif$
$for(header-includes)$
$header-includes$

$endfor$
#show: doc => conf(
$if(title)$
  title: [$title$],
$endif$
$if(subtitle)$
  subtitle: [$subtitle$],
$endif$
$if(keywords)$
  keywords: ($for(keywords)$$keyword$$sep$,$endfor$),
$endif$
$if(date)$
  date: [$date$],
$endif$
$if(lang)$
  lang: "$lang$",
$endif$
$if(region)$
  region: "$region$",
$endif$
$if(abstract)$
  abstract: [$abstract$],
$endif$
$if(margin)$
  margin: ($for(margin/pairs)$$margin.key$: $margin.value$,$endfor$),
$endif$
$if(mainfont)$
  font: ("$mainfont$",),
$endif$
$if(fontsize)$
  fontsize: $fontsize$,
$endif$
$if(section-numbering)$
  sectionnumbering: "$section-numbering$",
$endif$
$if(footer-note)$
  footer-note: [$footer-note$],
$endif$
  pagenumbering: $if(page-numbering)$"$page-numbering$"$else$"1"$endif$,
  cols: $if(columns)$$columns$$else$1$endif$,
  doc,
)

$for(include-before)$
$include-before$

$endfor$
$if(toc)$
#outline(title: [Contents], depth: $if(toc-depth)$$toc-depth$$else$3$endif$, indent: 1em)
#pagebreak()
$endif$

$body$

$if(citations)$
$if(csl)$
#set bibliography(style: "$csl$")
$elseif(bibliographystyle)$
#set bibliography(style: "$bibliographystyle$")
$endif$
$if(bibliography)$
#bibliography($for(bibliography)$"$bibliography$"$sep$,$endfor$)
$endif$
$endif$
$for(include-after)$

$include-after$
$endfor$
